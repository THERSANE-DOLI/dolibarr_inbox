InboxTestReadFoundCache = Mail found in the cache (folder %s)
InboxTestReadFailed = Mail not read (%s): %s
InboxTestFile = Test: parse a .eml or .msg file
InboxTestFileHelp = The file is parsed in memory and not kept.
InboxTestFileButton = Parse the file
InboxTestFileMissing = No file received
InboxTestFileFailed = File not parsed: %s
InboxTestResult = Mail read
InboxResult_found = found
InboxResult_notfound = not found
InboxResult_forbidden = not allowed
InboxResult_invalid = invalid mailbox or Message-ID
InboxResult_error = error


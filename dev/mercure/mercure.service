# Mercure hub for the instant refresh of inbox (1.124.0), without Docker.
# Install: the binary of a release (https://github.com/dunglas/mercure/releases) in /usr/local/bin/mercure, its
# Caddyfile in /etc/mercure/Caddyfile, the settings in /etc/mercure/mercure.env (mercure.env.example), a system user
# « mercure » (useradd --system --home /var/lib/mercure --create-home mercure), then:
#   cp mercure.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now mercure
[Unit]
Description=Mercure hub (instant refresh of inbox for Dolibarr)
After=network-online.target
Wants=network-online.target

[Service]
User=mercure
Group=mercure
EnvironmentFile=/etc/mercure/mercure.env
Environment=XDG_DATA_HOME=/var/lib/mercure XDG_CONFIG_HOME=/var/lib/mercure
ExecStart=/usr/local/bin/mercure run --config /etc/mercure/Caddyfile
Restart=on-failure
# Ports 80 and 443 only when Mercure does its own HTTPS
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mercure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

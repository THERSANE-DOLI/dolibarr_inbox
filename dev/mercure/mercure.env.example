# Settings of the Mercure hub run by systemd (mercure.service), copied to /etc/mercure/mercure.env, mode 600.
# Keys: random, at least 32 characters, different (for example: head -c 48 /dev/urandom | base64), typed the same in
# Inbox > Settings > Server > Push service. Never commit this file once filled.
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
# The « iss » of the tokens of inbox: the address of Dolibarr, typed the same as « Trusted issuer » in inbox
MERCURE_TRUSTED_ISSUERS=https://erp.example.com
# HTTP on the local loop behind nginx; or push.example.com for Mercure alone with automatic HTTPS (ports 80 and 443)
SERVER_NAME=127.0.0.1:3001
MERCURE_EXTRA_DIRECTIVES="cors_origins https://erp.example.com
transport local"
